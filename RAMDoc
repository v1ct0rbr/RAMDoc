def notify(summary, body):
    """Send a desktop notification via notify-send (best-effort)."""
    if not shutil.which("notify-send"):
        return False
    cmd = ["notify-send", "--app-name=RAMDoc"]
    if os.path.isfile(ICON_SVG):
        cmd += ["--icon", ICON_SVG]
    cmd += [str(summary), str(body)]
    try:
        subprocess.run(cmd, capture_output=True, timeout=5)
        return True
    except (OSError, subprocess.TimeoutExpired):
        return False


def make_tray_icon(percent, size=64):
    """Render a tray icon (equalizer bars) colored by RAM usage."""
    from PIL import Image, ImageDraw

    s = size * 4
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)

    margin = s * 0.03
    d.rounded_rectangle(
        [margin, margin, s - margin, s - margin],
        radius=s * 0.22,
        fill=(30, 32, 42, 255),
        outline=(46, 49, 66, 255),
        width=max(1, int(s * 0.02)),
    )

    percent = max(0.0, min(100.0, float(percent)))
    if percent < 50:
        color = (74, 222, 128, 255)
    elif percent < 80:
        color = (250, 204, 21, 255)
    else:
        color = (248, 113, 113, 255)

    bar_w = s * 0.12
    xs = [s * 0.21, s * 0.44, s * 0.67]
    bases = (0.26, 0.44, 0.32)
    growth = (0.44, 0.36, 0.40)
    bottom = s * 0.78
    for x, base, g in zip(xs, bases, growth):
        h = (base + g * percent / 100.0) * s
        top = bottom - h
        d.rounded_rectangle(
            [x, top, x + bar_w, bottom],
            radius=bar_w / 2,
            fill=color,
        )

    return img.resize((size, size), Image.LANCZOS)


