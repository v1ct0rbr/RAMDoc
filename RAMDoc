def _color_supported():
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


COLORS_ON = _color_supported()


def _c(code):
    return code if COLORS_ON else ""


class Colors:
    RED = _c("\033[91m")
    GREEN = _c("\033[92m")
    YELLOW = _c("\033[93m")
    BLUE = _c("\033[94m")
    PURPLE = _c("\033[95m")
    CYAN = _c("\033[96m")
    WHITE = _c("\033[97m")
    DIM = _c("\033[2m")
    BOLD = _c("\033[1m")
    RESET = _c("\033[0m")

    ALT_SCREEN_ON = "\033[?1049h" if COLORS_ON else ""
    ALT_SCREEN_OFF = "\033[?1049l" if COLORS_ON else ""
    CURSOR_HIDE = "\033[?25l" if COLORS_ON else ""
    CURSOR_SHOW = "\033[?25h" if COLORS_ON else ""
    CLEAR = "\033[H\033[2J" if COLORS_ON else ""


def human_size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024.0 or unit == "TB":
            if unit == "B":
                return f"{int(n)} B"
            return f"{n:.1f} {unit}"
        n /= 1024.0


ANSI_ESCAPE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def visible_len(text):
    return len(ANSI_ESCAPE.sub("", text))


def pad_visible(text, width):
    pad = width - visible_len(text)
    if pad > 0:
        return text + " " * pad
    return text


def box_line(content, width):
    return "│ " + pad_visible(content, width - 3) + " │"


def color_for_percent(percent):
    if percent < 50:
        return Colors.GREEN
    if percent < 80:
        return Colors.YELLOW
    return Colors.RED


def render_bar(percent, width=28):
    percent = max(0.0, min(100.0, float(percent)))
    filled = percent / 100.0 * width
    full = int(filled)
    frac = filled - full
    partial_chars = " ▏▎▍▌▋▊▉"
    bar = "█" * full
    if full < width:
        idx = int(frac * (len(partial_chars) - 1) + 0.5)
        bar += partial_chars[idx]
        bar += "░" * (width - full - 1)
    return f"{color_for_percent(percent)}{bar}{Colors.RESET}"


def sparkline(values, max_width=60):
    if not values:
        return ""
    vals = list(values)[-max_width:]
    blocks = "▁▂▃▄▅▆▇█"
    lo, hi = min(vals), max(vals)
    span = (hi - lo) or 1.0
    out = []
    for v in vals:
        idx = int((v - lo) / span * (len(blocks) - 1) + 0.5)
        out.append(blocks[max(0, min(len(blocks) - 1, idx))])
    return "".join(out)


def positive_int(value):
    n = int(value)
    if n <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return n


def positive_float(value):
    n = float(value)
    if n <= 0:
        raise argparse.ArgumentTypeError("must be a positive number")
    return n


def read_memory_psi():
    try:
        with open("/proc/pressure/memory") as f:
            line = f.readline()
        parts = dict(p.split("=") for p in line.split()[1:])
        return float(parts.get("avg10", 0.0))
    except (OSError, ValueError):
        return None


def collect_open_files():
    open_paths = set()
    try:
        pids = [d for d in os.listdir("/proc") if d.isdigit()]
    except OSError:
        return open_paths
    for pid in pids:
        fd_dir = f"/proc/{pid}/fd"
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
            except OSError:
                continue
            if target.startswith("/"):
                open_paths.add(os.path.realpath(target))
    return open_paths


