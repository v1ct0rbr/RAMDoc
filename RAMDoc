    @staticmethod
    def sudo_noninteractive_ok():
        if os.geteuid() == 0:
            return True
        if not shutil.which("sudo"):
            return False
        try:
            result = subprocess.run(
                ["sudo", "-n", "true"],
                capture_output=True,
                timeout=10,
            )
            return result.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False

    def drop_caches(self, interactive=True, quiet=False):
        """Clear page cache, dentries and inodes. Returns freed bytes or None."""
        before = psutil.virtual_memory().available
        try:
            result = subprocess.run(["sync"], capture_output=True, timeout=60)
            if result.returncode != 0 and not quiet:
                print(f"{Colors.YELLOW}Warning: sync returned {result.returncode}{Colors.RESET}")

            if os.geteuid() == 0:
                with open("/proc/sys/vm/drop_caches", "w") as f:
                    f.write("3\n")
                ok = True
            else:
                sudo_cmd = ["sudo"] if interactive else ["sudo", "-n"]
                result = subprocess.run(
                    sudo_cmd + ["sh", "-c", "echo 3 > /proc/sys/vm/drop_caches"],
                    capture_output=True,
                    text=True,
                    timeout=60,
                )
                ok = result.returncode == 0
                if not ok and not quiet:
                    stderr = (result.stderr or "").strip()
                    print(f"{Colors.RED}❌ Could not clear cache (exit {result.returncode})"
                          f"{Colors.RESET}")
                    if stderr:
                        print(f"{Colors.DIM}   {stderr}{Colors.RESET}")
                    if result.returncode in (1, 126, 127) or "password" in stderr.lower():
                        print(f"{Colors.YELLOW}   Tip: refresh your sudo ticket with: "
                              f"sudo -v{Colors.RESET}")
            if not ok:
                return None
        except subprocess.TimeoutExpired:
            if not quiet:
                print(f"{Colors.RED}❌ drop_caches timed out{Colors.RESET}")
            return None
        except OSError as e:
            if not quiet:
                print(f"{Colors.RED}❌ Error clearing cache: {e}{Colors.RESET}")
            return None

        after = psutil.virtual_memory().available
        freed = max(0, after - before)
        if not quiet:
            if freed > 1024 * 1024:
                print(f"{Colors.GREEN}✅ Memory cache cleared — "
                      f"{human_size(freed)} released "
                      f"({before / (1024**3):.2f}G → {after / (1024**3):.2f}G available){Colors.RESET}")
            else:
                print(f"{Colors.GREEN}✅ Memory cache cleared "
                      f"(little to reclaim — cache was already small){Colors.RESET}")
        return freed

    def clear_memory_cache(self):
        print(f"{Colors.YELLOW}🧹 Clearing memory cache...{Colors.RESET}")
        self.drop_caches(interactive=True, quiet=False)

    def find_large_files(self, directory="/home", min_size_mb=100, limit=20):
        """Find large files in the specified directory"""
        if not os.path.isdir(directory):
            print(f"{Colors.RED}Error: directory does not exist: {directory}{Colors.RESET}")
            return None

        print(f"{Colors.YELLOW}🔍 Scanning {directory} for files larger than "
              f"{min_size_mb}MB...{Colors.RESET}")

        large_files = []
        min_size_bytes = min_size_mb * 1024 * 1024
        scanned = 0
        seen_inodes = set()
        base_dev = os.stat(directory).st_dev

        try:
            for root, dirs, files in os.walk(directory):
                dirs[:] = [
                    d for d in dirs
                    if not os.path.islink(os.path.join(root, d))
                ]
                for name in files:
                    file_path = os.path.join(root, name)
                    try:
                        st = os.lstat(file_path)
                    except OSError:
                        continue
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    if st.st_dev != base_dev:
                        continue
                    scanned += 1
                    if scanned % 5000 == 0:
                        print(f"\r{Colors.DIM}   scanned {scanned:,} files...{Colors.RESET}",
                              end="", flush=True)
                    if st.st_nlink > 1:
                        key = (st.st_dev, st.st_ino)
                        if key in seen_inodes:
                            continue
                        seen_inodes.add(key)
                    if st.st_size > min_size_bytes:
                        large_files.append({
                            "path": file_path,
                            "size": st.st_size,
                        })
        except OSError as e:
            print(f"\r{Colors.RED}Error scanning directory: {e}{Colors.RESET}")
            return large_files or []

        if scanned >= 5000:
            print(f"\r{Colors.DIM}   scanned {scanned:,} files{Colors.RESET}".ljust(60))

        large_files.sort(key=lambda x: x["size"], reverse=True)
        total = len(large_files)
        print(f"{Colors.DIM}   {total} large file(s) found (showing {min(limit, total)}){Colors.RESET}")
        return large_files[:limit]

    def display_large_files(self, large_files):
